      "html": "<style>\n  :root{\n    --bg: #f6f7f8;\n    --surface: #ffffff;\n    --ink: #17181c;\n    --ink-soft: #55575e;\n    --muted: #9a9ca3;\n    --line: #e8e9ec;\n    --blue: #2f7cf6;\n    --blue-soft: #dcecff;\n    --green: #22b573;\n    --green-soft: #e4f7ee;\n    --lime: #5fae2e;\n    --radius-lg: 20px;\n    --radius-md: 14px;\n    --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, Helvetica, Arial, sans-serif;\n    --font-mono: \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace;\n  }\n\n  *{ box-sizing:border-box; margin:0; padding:0; }\n  html,body{ height:100%; }\n  body{\n    background:var(--bg);\n    color:var(--ink);\n    font-family:var(--font);\n    -webkit-font-smoothing:antialiased;\n    overflow-x:hidden;\n  }\n\n  .hero{\n    position:relative;\n    min-height:100vh;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    overflow:hidden;\n    padding:24px 24px 0;\n  }\n\n  /* ---------- Floating nav ---------- */\n  .nav{\n    width:100%;\n    max-width:1120px;\n    background:var(--surface);\n    border-radius:999px;\n    box-shadow:0 10px 34px -18px rgba(23,24,28,0.22);\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:10px 12px 10px 26px;\n    position:relative;\n    z-index:3;\n  }\n  .brand{\n    display:flex;\n    align-items:center;\n    gap:9px;\n    font-size:19px;\n    font-weight:700;\n    letter-spacing:-0.02em;\n    color:var(--ink);\n    text-decoration:none;\n  }\n  .nav-links{ display:flex; align-items:center; gap:28px; }\n  .nav-link{\n    color:var(--ink-soft);\n    font-size:15px;\n    font-weight:500;\n    text-decoration:none;\n  }\n  .nav-link:hover{ color:var(--ink); }\n  .nav-right{ display:flex; align-items:center; gap:18px; }\n  .login{ color:var(--ink); font-size:15px; font-weight:500; text-decoration:none; }\n  .btn-dark{\n    background:var(--ink);\n    color:#fff;\n    font-size:15px;\n    font-weight:600;\n    padding:13px 24px;\n    border-radius:999px;\n    text-decoration:none;\n  }\n  .btn-dark{ transition:background 0.2s cubic-bezier(0.16,1,0.3,1); }\n  .btn-dark:hover{ background:#2c2d33; }\n\n  /* ---------- Copy ---------- */\n  .copy{\n    position:relative;\n    z-index:2;\n    text-align:center;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    padding:64px 8px 0;\n  }\n  .badge{\n    background:var(--blue-soft);\n    color:#1c62cf;\n    font-size:14px;\n    font-weight:600;\n    padding:8px 16px;\n    border-radius:999px;\n  }\n  h1{\n    margin-top:22px;\n    font-size:clamp(42px, 6vw, 76px);\n    line-height:1.05;\n    font-weight:800;\n    letter-spacing:-0.035em;\n    max-width:16ch;\n  }\n  .sub{\n    margin-top:20px;\n    font-size:17px;\n    line-height:1.6;\n    color:var(--muted);\n    font-weight:500;\n    max-width:52ch;\n  }\n  .btn-hero{\n    margin-top:28px;\n    background:var(--ink);\n    color:#fff;\n    font-size:16px;\n    font-weight:600;\n    padding:16px 30px;\n    border-radius:999px;\n    text-decoration:none;\n    box-shadow:0 14px 30px -12px rgba(23,24,28,0.4);\n    transition:transform 0.15s ease;\n  }\n  .btn-hero:hover{ transform:translateY(-2px); }\n\n  .fees{\n    display:flex;\n    align-items:center;\n    flex-wrap:wrap;\n    justify-content:center;\n    gap:14px 34px;\n    margin-top:34px;\n  }\n  .fee{\n    display:flex;\n    align-items:center;\n    gap:8px;\n    color:var(--blue);\n    font-size:15px;\n    font-weight:600;\n  }\n  .fee .drop{\n    color:var(--lime);\n    font-size:13px;\n    display:flex;\n    align-items:center;\n    gap:2px;\n  }\n\n  /* ---------- Invoice flat-lay ---------- */\n  .flatlay{\n    position:relative;\n    width:100%;\n    max-width:1000px;\n    height:480px;\n    margin-top:56px;\n  }\n  .sheet{\n    position:absolute;\n    background:var(--surface);\n    border-radius:6px;\n    box-shadow:0 24px 60px -24px rgba(23,24,28,0.28);\n  }\n  /* Tall enough to bleed decisively past the page fold instead of ending in a\n     10px sliver at the exact bottom edge. */\n  .sheet.ghost-l{\n    width:340px; height:540px;\n    left:6%; top:70px;\n    transform:rotate(-9deg);\n  }\n  .sheet.ghost-r{\n    width:320px; height:540px;\n    right:5%; top:56px;\n    transform:rotate(7deg);\n  }\n  .ghost-inner{ padding:26px; }\n  .ghost-inner .mini-label{\n    font-size:10px;\n    letter-spacing:0.12em;\n    color:var(--muted);\n    font-weight:600;\n  }\n  .ghost-inner .mini-num{ margin-top:6px; font-weight:700; font-size:14px; }\n  .ghost-inner .mini-bar{ margin-top:20px; height:10px; border-radius:5px; background:#eef0f3; }\n  .ghost-inner .mini-bar.short{ width:60%; }\n\n  .invoice{\n    position:absolute;\n    left:50%;\n    top:0;\n    transform:translateX(-50%);\n    width:min(620px, 92%);\n    background:var(--surface);\n    border-radius:8px;\n    box-shadow:0 34px 80px -30px rgba(23,24,28,0.35);\n    z-index:2;\n  }\n  .inv-head{\n    padding:24px 30px;\n    border-bottom:1px solid var(--line);\n  }\n  .label{\n    font-size:11px;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n    color:var(--muted);\n    font-weight:600;\n  }\n  .inv-head .num{ margin-top:6px; font-weight:700; font-size:15px; }\n  .inv-parties{\n    display:grid;\n    grid-template-columns:1fr 1fr;\n    border-bottom:1px solid var(--line);\n  }\n  .party{ padding:24px 30px; }\n  .party + .party{ border-left:1px solid var(--line); }\n  .party .avatar{\n    margin-top:14px;\n    width:34px; height:34px;\n    border-radius:50%;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n  }\n  .party .avatar.blue{ background:radial-gradient(circle at 32% 30%, #5b9bff, #1d54d8); }\n  .party .avatar.green{ background:var(--green); }\n  .party h3{ margin-top:12px; font-size:19px; font-weight:700; letter-spacing:-0.01em; }\n  .party .email{ margin-top:5px; font-size:13.5px; color:var(--ink-soft); }\n  .party .addr{ margin-top:12px; font-size:13px; line-height:1.55; color:var(--muted); }\n  .inv-table{ padding:20px 30px 26px; }\n  .row{\n    display:grid;\n    grid-template-columns:1fr 60px 110px 110px;\n    gap:12px;\n    align-items:center;\n  }\n  .row.head{ padding-bottom:12px; }\n  .row.head span{\n    font-size:10.5px;\n    letter-spacing:0.12em;\n    text-transform:uppercase;\n    color:var(--muted);\n    font-weight:600;\n  }\n  .row.body{\n    padding:14px 0 4px;\n    border-top:1px solid var(--line);\n    font-size:14.5px;\n    font-weight:600;\n  }\n  .row .r{ text-align:right; }\n  .row .amt{ font-family:var(--font-mono); }\n\n  @media (max-width:900px){\n    .nav-links{ display:none; }\n    .sheet.ghost-l, .sheet.ghost-r{ display:none; }\n    .flatlay{ height:auto; padding-bottom:40px; }\n    .invoice{ position:relative; left:auto; transform:none; margin:0 auto; }\n  }\n</style>\n\n<section class=\"hero\">\n\n  <nav class=\"nav\">\n    <a class=\"brand\" href=\"#\">\n      <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3\" y=\"2.5\" width=\"14\" height=\"17\" rx=\"2.5\" stroke=\"#17181c\" stroke-width=\"2\"/><path d=\"M7 7.5h6M7 11h6M7 14.5h3.5\" stroke=\"#17181c\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"17.5\" cy=\"17.5\" r=\"4.5\" fill=\"#2f7cf6\" stroke=\"#f6f7f8\" stroke-width=\"1.6\"/><path d=\"m15.8 17.5 1.2 1.2 2-2.2\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      Papertrail\n    </a>\n    <div class=\"nav-links\">\n      <a class=\"nav-link\" href=\"#\">Freelancer</a>\n      <a class=\"nav-link\" href=\"#\">Agency</a>\n      <a class=\"nav-link\" href=\"#\">Pricing</a>\n      <a class=\"nav-link\" href=\"#\">Blog</a>\n      <a class=\"nav-link\" href=\"#\">Guides</a>\n    </div>\n    <div class=\"nav-right\">\n      <a class=\"login\" href=\"#\">Log in</a>\n      <a class=\"btn-dark\" href=\"#\">Sign up for free</a>\n    </div>\n  </nav>\n\n  <div class=\"copy\">\n    <span class=\"badge\">Trusted by 7,400+ studios worldwide</span>\n    <h1>Small business invoices that get paid faster</h1>\n    <p class=\"sub\">Send an invoice in seconds. Your clients pay how they want. You get paid direct to your bank or wallet, with no monthly fee.</p>\n    <a class=\"btn-hero\" href=\"#\">Send my first invoice</a>\n    <div class=\"fees\">\n      <span class=\"fee\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#2f7cf6\"/><path d=\"m7.5 12.2 3 3 5.5-6\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Cards 2.7% <span class=\"drop\">▾ 0.2%</span>\n      </span>\n      <span class=\"fee\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#2f7cf6\"/><path d=\"m7.5 12.2 3 3 5.5-6\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Bank transfer 1%\n      </span>\n      <span class=\"fee\">\n        <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"11\" fill=\"#2f7cf6\"/><path d=\"m7.5 12.2 3 3 5.5-6\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n        Stablecoin 1%\n      </span>\n    </div>\n  </div>\n\n  <div class=\"flatlay\">\n    <!-- background sheets -->\n    <div class=\"sheet ghost-l\">\n      <div class=\"ghost-inner\">\n        <div class=\"mini-label\">INVOICE NO</div>\n        <div class=\"mini-num\">002</div>\n        <div class=\"mini-bar\"></div>\n        <div class=\"mini-bar short\"></div>\n      </div>\n    </div>\n    <div class=\"sheet ghost-r\">\n      <div class=\"ghost-inner\">\n        <div class=\"mini-label\">INVOICE NO</div>\n        <div class=\"mini-num\">003</div>\n        <div class=\"mini-bar\"></div>\n        <div class=\"mini-bar short\"></div>\n      </div>\n    </div>\n\n    <!-- main invoice -->\n    <div class=\"invoice\">\n      <div class=\"inv-head\">\n        <div class=\"label\">Invoice No</div>\n        <div class=\"num\">001</div>\n      </div>\n      <div class=\"inv-parties\">\n        <div class=\"party\">\n          <div class=\"label\">From</div>\n          <div class=\"avatar blue\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2.5 14.4 8l5.6.6-4.2 3.9 1.2 5.6L12 15.2 7 18.1l1.2-5.6L4 8.6 9.6 8 12 2.5Z\" fill=\"#fff\"/></svg>\n          </div>\n          <h3>Marble Studio</h3>\n          <div class=\"email\">billing@marble.studio</div>\n          <div class=\"addr\">742 Evergreen Terrace,<br>Springfield, OR 97477</div>\n        </div>\n        <div class=\"party\">\n          <div class=\"label\">To</div>\n          <div class=\"avatar green\">\n            <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 5v14M5 12h14\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linecap=\"round\"/></svg>\n          </div>\n          <h3>Charm AI</h3>\n          <div class=\"email\">billing@charm.ai</div>\n          <div class=\"addr\">1313 Mockingbird Lane,<br>Los Angeles, CA 90028</div>\n        </div>\n      </div>\n      <div class=\"inv-table\">\n        <div class=\"row head\">\n          <span>Description</span>\n          <span class=\"r\">Qty</span>\n          <span class=\"r\">Price</span>\n          <span class=\"r\">Amount</span>\n        </div>\n        <div class=\"row body\">\n          <span>Design Services</span>\n          <span class=\"r\">1</span>\n          <span class=\"r amt\">$45,000</span>\n          <span class=\"r amt\">$45,000.00</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n",
