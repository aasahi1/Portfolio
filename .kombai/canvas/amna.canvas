    },
    "87bcb0fd-6c04-4fa6-9c1e-bc06808a186b": {
      "type": "variant",
      "id": "87bcb0fd-6c04-4fa6-9c1e-bc06808a186b",
      "label": "web_10",
      "parentId": null,
      "rect": {
        "x": 7897,
        "y": 135,
        "w": 1440,
        "h": 900
      },
      "generation": {
        "prompt": "",
        "config": {}
      },
      "html": "<style>\n  :root{\n    --ink:#111d16;\n    --ink-soft:#36463d;\n    --muted:#848e88;\n    --muted-2:#99a59e;\n    --surface:#f1f9f4;\n    --card:#f8fffb;\n    --chip:#e2f0e7;\n    --hair:#d7e7de;\n    --accent:#526c5c;\n\n    --pad-x:88px;\n    --nav-h:76px;\n\n    --fs-nav:18px;\n    --fs-display:58px;\n    --fs-lede:16px;\n    --fs-ui:15px;\n    --fs-sm:13.5px;\n\n    --r-pill:999px;\n    --r-lg:20px;\n    --r-md:16px;\n    --r-sm:8px;\n    --ease:cubic-bezier(0.16,1,0.3,1);\n  }\n\n  *,*::before,*::after{box-sizing:border-box}\n  html,body{margin:0;padding:0}\n  body{\n    background:var(--surface);\n    color:var(--ink);\n    font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Display\",\"SF Pro Text\",\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n    -webkit-font-smoothing:antialiased;\n  }\n  h1,h2,p,ul,li,figure,blockquote{margin:0;padding:0}\n  ul{list-style:none}\n  a{color:inherit;text-decoration:none}\n  img{display:block;max-width:100%}\n  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}\n\n  .wrap{\n    max-width:1440px;\n    margin:0 auto;\n    padding:0 var(--pad-x);\n  }\n\n  /* ---------- nav ---------- */\n  .nav{\n    height:var(--nav-h);\n    border-bottom:1px solid var(--hair);\n    background:var(--card);\n  }\n  .nav .wrap{\n    height:100%;\n    display:flex;\n    align-items:center;\n    gap:26px;\n  }\n  .brand{\n    flex:0 0 auto;\n    display:inline-flex;\n    align-items:center;\n    gap:13px;\n    transition:opacity .4s var(--ease);\n  }\n  .brand:hover{opacity:.7}\n  .brand svg{width:34px;height:34px;display:block;flex:0 0 auto}\n  .brand b{\n    font-size:20px;\n    font-weight:550;\n    letter-spacing:-.018em;\n    line-height:1;\n    color:var(--ink);\n  }\n  .nav-rule{\n    flex:0 0 auto;\n    width:1px;\n    height:26px;\n    background:var(--hair);\n    margin-left:4px;\n  }\n  .nav-links{\n    display:flex;\n    align-items:center;\n    gap:26px;\n    min-width:0;\n  }\n  .nav-links a{\n    font-size:var(--fs-nav);\n    font-weight:400;\n    line-height:1;\n    color:var(--muted);\n    white-space:nowrap;\n    transition:color .4s var(--ease);\n  }\n  .nav-links a:hover{color:var(--ink)}\n\n  .nav-cta{\n    margin-left:auto;\n    flex:0 0 auto;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    height:42px;\n    padding:0 22px;\n    border-radius:var(--r-pill);\n    border:1px solid var(--hair);\n    background:var(--card);\n    font-size:var(--fs-ui);\n    font-weight:600;\n    line-height:1;\n    color:var(--ink);\n    white-space:nowrap;\n    transition:background-color .4s var(--ease),border-color .4s var(--ease),transform .4s var(--ease);\n  }\n  .nav-cta:hover{background:var(--chip);border-color:#cadbd1;transform:translateY(-1px)}\n  .nav-cta:active{transform:translateY(0)}\n\n  /* ---------- hero ---------- */\n  .hero{\n    position:relative;\n    min-height:824px;\n    overflow:hidden;\n    background:\n      radial-gradient(58% 62% at 76% 44%, rgba(255,255,255,.95) 0%, rgba(255,255,255,0) 70%),\n      linear-gradient(180deg,#f4fcf7 0%,var(--surface) 58%,#e9f5ee 100%);\n  }\n  .stage{\n    display:grid;\n    grid-template-columns:1fr 594px;\n    align-items:start;\n  }\n\n  /* ---------- left column ---------- */\n  .lead{padding-top:165px;min-width:0}\n\n  .tag{\n    display:inline-flex;\n    align-items:center;\n    gap:9px;\n    height:32px;\n    padding:0 15px;\n    border-radius:var(--r-pill);\n    background:var(--chip);\n    font-size:var(--fs-ui);\n    font-weight:550;\n    line-height:1;\n    color:var(--ink);\n    white-space:nowrap;\n    transition:background-color .4s var(--ease),transform .4s var(--ease);\n  }\n  .tag:hover{background:#d5e9dd;transform:translateY(-1px)}\n  .tag svg{width:15px;height:15px;display:block;flex:0 0 auto}\n\n  h1{\n    margin-top:34px;\n    font-size:var(--fs-display);\n    font-weight:450;\n    line-height:1.207;\n    letter-spacing:-.021em;\n    color:var(--ink);\n  }\n  .alt{\n    font-family:Georgia,\"Iowan Old Style\",\"Times New Roman\",serif;\n    font-style:italic;\n    font-weight:400;\n    letter-spacing:0;\n  }\n\n  .lede{\n    margin-top:7px;\n    max-width:350px;\n    font-size:var(--fs-lede);\n    line-height:1.66;\n    color:var(--muted);\n  }\n\n  .signup{\n    margin-top:46px;\n    display:flex;\n    align-items:center;\n    gap:6px;\n  }\n  .field{\n    flex:0 0 auto;\n    width:294px;\n    height:45px;\n    padding:0 17px;\n    border:1px solid transparent;\n    border-radius:var(--r-pill);\n    background:var(--chip);\n    font-family:inherit;\n    font-size:var(--fs-ui);\n    line-height:1;\n    color:var(--ink);\n    transition:background-color .4s var(--ease),border-color .4s var(--ease);\n  }\n  .field::placeholder{color:var(--muted-2)}\n  .field:hover{background:#d8ece0}\n  .field:focus{outline:none;background:var(--card);border-color:var(--accent)}\n\n  .submit{\n    flex:0 0 auto;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    height:45px;\n    padding:0 26px;\n    border:0;\n    border-radius:var(--r-pill);\n    background:var(--ink);\n    color:#f6fdf9;\n    font-family:inherit;\n    font-size:var(--fs-ui);\n    font-weight:600;\n    line-height:1;\n    white-space:nowrap;\n    cursor:pointer;\n    box-shadow:0 14px 28px -16px rgba(17,29,22,.65);\n    transition:background-color .4s var(--ease),transform .4s var(--ease);\n  }\n  .submit:hover{background:#203027;transform:translateY(-1px)}\n  .submit:active{transform:translateY(0)}\n\n  .proof{\n    margin-top:33px;\n    display:flex;\n    align-items:center;\n    gap:11px;\n  }\n  .faces{display:flex;align-items:center;flex:0 0 auto}\n  .faces img{\n    display:block;\n    box-sizing:border-box;\n    width:28px;\n    height:28px;\n    border-radius:50%;\n    object-fit:cover;\n    object-position:50% 26%;\n    border:2px solid var(--surface);\n    background:linear-gradient(140deg,#c5dccf,#a7bfb1);\n  }\n  .faces > *:not(:first-child){margin-left:-11px}\n  .proof p{\n    min-width:0;\n    font-size:var(--fs-sm);\n    line-height:1.4;\n    color:var(--muted);\n  }\n  .proof strong{font-weight:650;color:var(--ink)}\n\n  /* ---------- right column ---------- */\n  .showcase{position:relative;padding-top:82px;min-width:0}\n\n  .shot{\n    position:relative;\n    width:594px;\n    height:583px;\n    border-radius:var(--r-lg);\n    overflow:hidden;\n    background:linear-gradient(150deg,#c2d9cc 0%,#8ea798 46%,#637e6e 100%);\n    box-shadow:0 40px 80px -46px rgba(25,37,30,.55),0 3px 10px -4px rgba(25,37,30,.14);\n  }\n  .shot img{width:100%;height:100%;object-fit:cover;object-position:50% 32%}\n\n  .quote{\n    position:absolute;\n    left:-74px;\n    top:432px;\n    z-index:2;\n    width:315px;\n    padding:20px 22px 21px;\n    border-radius:var(--r-md);\n    background:var(--card);\n    border:1px solid rgba(25,37,30,.05);\n    box-shadow:0 26px 54px -28px rgba(25,37,30,.42),0 2px 6px -2px rgba(25,37,30,.10);\n  }\n  .stars{display:flex;align-items:center;gap:5px}\n  .stars svg{width:16px;height:16px;display:block;flex:0 0 auto}\n  .stars .off{color:#c9d9d0}\n  .quote blockquote{\n    margin-top:13px;\n    font-size:var(--fs-sm);\n    line-height:1.5;\n    color:var(--ink-soft);\n  }\n  .who{\n    margin-top:16px;\n    display:flex;\n    align-items:center;\n    gap:14px;\n  }\n  .who .face{\n    display:block;\n    box-sizing:border-box;\n    width:36px;height:36px;\n    flex:0 0 auto;\n    border-radius:var(--r-sm);\n    object-fit:cover;\n    background:linear-gradient(140deg,#c5dccf,#a7bfb1);\n  }\n  .who .meta{min-width:0}\n  .who .name{\n    font-size:var(--fs-ui);\n    font-weight:600;\n    line-height:1.15;\n    color:var(--ink);\n  }\n  .who .sub{\n    margin-top:5px;\n    display:flex;\n    align-items:center;\n    gap:7px;\n    font-size:var(--fs-sm);\n    line-height:1;\n    color:var(--muted);\n  }\n  .score{\n    display:inline-flex;\n    align-items:center;\n    gap:4px;\n    padding:3px 7px;\n    border-radius:5px;\n    background:var(--chip);\n    font-size:12.5px;\n    font-weight:600;\n    line-height:1;\n    color:var(--ink);\n  }\n  .score svg{width:11px;height:11px;display:block;color:var(--accent)}\n\n  .dots{\n    margin-top:32px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    gap:12px;\n  }\n  .dots span{\n    display:block;\n    width:7px;height:7px;\n    border-radius:50%;\n    background:#c0d2c7;\n  }\n  .dots .on{width:11px;height:11px;background:var(--accent)}\n</style>\n\n\n  <header class=\"nav\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"#\">\n        <svg viewBox=\"0 0 34 34\" fill=\"none\" aria-hidden=\"true\">\n          <circle cx=\"17\" cy=\"17\" r=\"10.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n          <path d=\"M3.5 17h27\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n        </svg>\n        <b>Adjoin</b>\n      </a>\n      <span class=\"nav-rule\" aria-hidden=\"true\"></span>\n\n      <nav class=\"nav-links\" aria-label=\"Primary\">\n        <a href=\"#\">Why Adjoin</a>\n        <a href=\"#\">Who it's for</a>\n        <a href=\"#\">Features</a>\n        <a href=\"#\">Claim your handle</a>\n      </nav>\n\n      <a class=\"nav-cta\" href=\"#\">Join the list</a>\n    </div>\n  </header>\n\n  <section class=\"hero\">\n    <div class=\"wrap stage\">\n\n      <div class=\"lead\">\n        <a class=\"tag\" href=\"#\">\n          <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\">\n            <rect x=\"4.5\" y=\"1.5\" width=\"7\" height=\"13\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.5\"/>\n            <path d=\"M7 12.4h2\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n          </svg>\n          Mobile apps land in March\n        </a>\n\n        <h1>Se<span class=\"alt\">a</span>rch. Sh<span class=\"alt\">o</span>rtlist. Book.<br>\n          O<span class=\"alt\">ne</span> roster, one workflow.</h1>\n\n        <p class=\"lede\">Browse vetted photographers, stylists and crews — book the whole shoot in one thread.</p>\n\n        <form class=\"signup\" action=\"#\" onsubmit=\"return false\">\n          <input class=\"field\" type=\"email\" placeholder=\"Your work email\" aria-label=\"Your work email\">\n          <button class=\"submit\" type=\"submit\">Get My Invite</button>\n        </form>\n\n        <div class=\"proof\">\n          <div class=\"faces\">\n            <img width=\"28\" height=\"28\" src=\"https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&amp;w=200\" alt=\"Member portrait, photo by Jake Nackos on Unsplash\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n            <img width=\"28\" height=\"28\" src=\"https://images.pexels.com/photos/20249686/pexels-photo-20249686.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200\" alt=\"Member portrait, photo by Korede Adenola on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n            <img width=\"28\" height=\"28\" src=\"https://images.pexels.com/photos/11357048/pexels-photo-11357048.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200\" alt=\"Member portrait, photo by Foto Sushi on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n          </div>\n          <p><strong>4,180 creatives</strong> already on the early-access list</p>\n        </div>\n      </div>\n\n      <div class=\"showcase\">\n        <figure class=\"shot\">\n          <img src=\"https://images.pexels.com/photos/5416645/pexels-photo-5416645.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200\"\n               alt=\"A creative on location at golden hour, photo by Arina Krasnikova on Pexels\"\n               width=\"594\" height=\"583\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n        </figure>\n\n        <div class=\"quote\">\n            <div class=\"stars\" aria-label=\"Rated 4 out of 5\">\n              <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n              <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n              <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n              <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n              <svg class=\"off\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n            </div>\n            <blockquote>Booked the crew on Tuesday and shot on Thursday. Four messages, start to finish.</blockquote>\n            <div class=\"who\">\n              <img class=\"face\" width=\"36\" height=\"36\"\n                   src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200\"\n                   alt=\"Portrait of Priya Raskin, photo by Thanh Xuan Nguyen Ly on Pexels\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              <div class=\"meta\">\n                <div class=\"name\">Priya Raskin</div>\n                <div class=\"sub\">\n                  <span class=\"score\">4.9\n                    <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"m8 1.6 1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4 4.2 13.4l.7-4.3-3.1-3 4.3-.6L8 1.6Z\" fill=\"currentColor\"/></svg>\n                  </span>\n                  <span>· Set designer</span>\n                </div>\n              </div>\n            </div>\n        </div>\n\n        <div class=\"dots\" aria-hidden=\"true\">\n          <span></span><span></span><span class=\"on\"></span><span></span><span></span>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n",
