    "88125de5-0c40-4b42-9461-a9a8707984ec": {
      "type": "variant",
      "id": "88125de5-0c40-4b42-9461-a9a8707984ec",
      "label": "hero_web_4",
      "parentId": null,
      "rect": {
        "x": 6257,
        "y": 135,
        "w": 1440,
        "h": 1206
