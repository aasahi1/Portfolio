      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19383/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \"tmp-gallery-import/footer-web-14-f05bed90.canvas\", nodeId: \"58acbf54-c0b4-4202-90de-29cc97946323\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><title data-kid=\"0\">Yieldr — Earn from your data</title>\n<style data-kid=\"1\">\n  :root{\n    --bg:#eef0f5;\n    --ink:#101014;\n    --primary:#4f74f0;        /* was purple */\n    --primary-2:#3d5fe0;\n    --panel:#cdd7fb;          /* was light purple */\n    --accent:#20e3c4;         /* was lime green */\n    --accent-2:#0fc7ab;\n    --hot:#ff5c7c;            /* was orange */\n    --hot-2:#ff7a52;\n    --illus-1:#12c9a0;\n    --illus-2:#26e07a;\n    --illus-3:#a8f24a;\n    --line:#b9c2e6;\n    --radius:34px;\n    --sans:\"Helvetica Neue\",Helvetica,Arial,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;}\n  body{\n    background:var(--bg);\n    color:var(--ink);\n    font-family:var(--sans);\n    -webkit-font-smoothing:antialiased;\n    padding:clamp(18px,3.2vw,60px);\n    min-height:100vh;\n  }\n  .wrap{max-width:1720px;margin:0 auto;}\n\n  .grid{\n    display:grid;\n    grid-template-columns:1fr 1.02fr;\n    gap:clamp(16px,1.7vw,30px);\n    align-items:stretch;\n  }\n  .col{display:flex;flex-direction:column;gap:clamp(16px,1.7vw,30px);}\n\n  /* ---- illustration card ---- */\n  .illus{\n    position:relative;\n    border-radius:var(--radius);\n    overflow:hidden;\n    aspect-ratio:1/1.02;\n    background:\n      radial-gradient(120% 90% at 20% 0%, var(--illus-3) 0%, transparent 55%),\n      radial-gradient(120% 120% at 90% 20%, var(--illus-2) 0%, transparent 60%),\n      linear-gradient(135deg,var(--illus-1),#0a9e7e 70%);\n  }\n  .illus::before{\n    content:\"\";position:absolute;inset:0;\n    background:\n      conic-gradient(from 210deg at 65% 40%, transparent 0deg, rgba(255,255,255,.14) 40deg, transparent 90deg),\n      repeating-linear-gradient(58deg, rgba(0,60,45,.14) 0 26px, transparent 26px 60px);\n    mix-blend-mode:multiply;\n  }\n  .illus .blob{\n    position:absolute;border-radius:46% 54% 60% 40%/50% 42% 58% 50%;\n    filter:blur(2px);opacity:.9;\n  }\n  .illus .b1{width:44%;height:52%;left:12%;top:18%;background:var(--hot);border-radius:48% 52% 44% 56%/56% 44% 56% 44%;}\n  .illus .b2{width:30%;height:34%;right:8%;top:10%;background:var(--illus-3);}\n  .illus .b3{width:38%;height:30%;left:26%;bottom:8%;background:var(--accent);opacity:.85;}\n  .illus .glass{\n    position:absolute;right:18%;top:16%;width:16%;height:9%;\n    background:var(--hot);border-radius:40px;transform:rotate(-8deg);\n    box-shadow:0 0 0 6px rgba(255,255,255,.25);\n  }\n\n  /* ---- wordmark arrow card ---- */\n  .wordmark{\n    position:relative;\n    background:linear-gradient(120deg,var(--hot),var(--hot-2));\n    border-radius:var(--radius);\n    padding:clamp(20px,3vw,44px) clamp(24px,4vw,60px);\n    min-height:clamp(200px,20vw,300px);\n    display:flex;align-items:center;\n    clip-path:polygon(0 0,88% 0,100% 50%,88% 100%,0 100%);\n  }\n  .wordmark span{\n    font-weight:900;\n    font-size:clamp(78px,13vw,210px);\n    line-height:.78;\n    letter-spacing:-.04em;\n    color:var(--ink);\n  }\n\n  /* ---- CTA card ---- */\n  .cta-card{\n    position:relative;\n    background:var(--primary);\n    border-radius:var(--radius);\n    padding:clamp(28px,3.4vw,58px);\n    aspect-ratio:1/1.02;\n    display:flex;flex-direction:column;\n  }\n  .cta-card h1{\n    margin:0;\n    font-weight:900;\n    letter-spacing:-.035em;\n    line-height:.92;\n    font-size:clamp(44px,6.6vw,108px);\n    color:var(--ink);\n  }\n  .cta-card p{\n    margin:clamp(20px,2.4vw,40px) 0 0;\n    max-width:30ch;\n    font-weight:500;\n    line-height:1.45;\n    font-size:clamp(15px,1.25vw,23px);\n    color:rgba(15,15,20,.85);\n  }\n  .cta-row{\n    margin-top:auto;\n    display:flex;align-items:stretch;gap:clamp(10px,1.1vw,18px);\n  }\n  .cta-icon{\n    background:var(--accent);\n    color:var(--ink);\n    display:flex;align-items:center;justify-content:center;\n    padding:0 clamp(14px,1.6vw,26px);\n    clip-path:polygon(0 0,72% 0,100% 50%,72% 100%,0 100%);\n    border-radius:20px 0 0 20px;\n  }\n  .cta-icon svg{width:clamp(26px,2.4vw,42px);height:auto;}\n  .cta-btn{\n    flex:1;\n    background:var(--ink);\n    color:#fff;\n    border:0;border-radius:22px;\n    font-family:inherit;\n    font-weight:800;\n    letter-spacing:-.01em;\n    font-size:clamp(18px,2vw,38px);\n    cursor:pointer;\n    padding:clamp(18px,2.4vw,40px);\n    transition:transform .18s ease,background .18s ease;\n  }\n  .cta-btn:hover{background:#26262e;transform:translateY(-2px);}\n  .cta-btn:active{transform:translateY(1px);}\n  .cta-btn:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}\n\n  /* ---- footer links panel ---- */\n  .links{\n    background:var(--panel);\n    border-radius:var(--radius);\n    padding:clamp(24px,2.4vw,42px) clamp(24px,2.8vw,52px);\n    display:grid;\n    grid-template-columns:1fr 1fr 1fr;\n    gap:clamp(16px,2vw,40px);\n  }\n  .links h4{\n    margin:0 0 clamp(14px,1.6vw,26px);\n    font-weight:600;\n    font-size:clamp(13px,1.05vw,19px);\n    color:rgba(16,16,20,.7);\n  }\n  .links a{\n    display:block;\n    text-decoration:none;\n    color:var(--ink);\n    font-weight:800;\n    font-size:clamp(15px,1.25vw,23px);\n    margin-bottom:clamp(6px,.7vw,12px);\n    transition:opacity .15s ease;\n  }\n  .links a:hover{opacity:.6;}\n  .legal{font-size:clamp(13px,1.05vw,19px);}\n  .legal a{font-weight:700;margin-bottom:4px;}\n  .legal .copy{color:rgba(16,16,20,.45);font-weight:700;margin-top:clamp(10px,1.2vw,20px);}\n\n  /* ---- social pills ---- */\n  .socials{\n    display:grid;\n    grid-template-columns:1.7fr 1fr 1.7fr;\n    gap:clamp(12px,1.4vw,24px);\n  }\n  .pill{\n    background:transparent;\n    border:1.5px solid var(--line);\n    border-radius:100px;\n    text-decoration:none;\n    color:var(--ink);\n    font-weight:800;\n    font-size:clamp(15px,1.3vw,24px);\n    text-align:center;\n    padding:clamp(16px,1.7vw,30px);\n    transition:background .16s ease,border-color .16s ease;\n  }\n  .pill:hover{background:#fff;border-color:var(--primary);}\n  .pill:focus-visible{outline:3px solid var(--primary);outline-offset:3px;}\n\n  /* ---- toggle ---- */\n  .toggle-wrap{display:flex;justify-content:flex-end;margin-top:clamp(14px,1.6vw,26px);}\n  .toggle{\n    display:inline-flex;align-items:center;gap:10px;\n    background:var(--ink);color:#fff;\n    border-radius:100px;padding:8px 8px 8px 18px;\n    font-weight:700;font-size:14px;\n  }\n  .toggle .knob{\n    width:34px;height:34px;border-radius:50%;\n    background:var(--hot);\n    display:flex;align-items:center;justify-content:center;\n  }\n  .toggle .knob svg{width:16px;height:16px;}\n\n  @media(max-width:860px){\n    .grid{grid-template-columns:1fr;}\n    .illus,.cta-card{aspect-ratio:1/1;}\n    .links{grid-template-columns:1fr 1fr;}\n    .legal{grid-column:1/-1;}\n    .socials{grid-template-columns:1fr;}\n    .wordmark{clip-path:polygon(0 0,92% 0,100% 50%,92% 100%,0 100%);}\n  }\n  @media(max-width:480px){\n    .cta-card h1{font-size:14vw;}\n  }\n</style>\n\n<div class=\"wrap\" data-kid=\"2\">\n  <div class=\"grid\" data-kid=\"3\">\n\n    \n    <div class=\"col\" data-kid=\"4\">\n      <div class=\"illus\" role=\"img\" aria-label=\"Abstract data collector illustration\" data-kid=\"5\">\n        <span class=\"blob b1\" data-kid=\"6\"></span>\n        <span class=\"blob b2\" data-kid=\"7\"></span>\n        <span class=\"blob b3\" data-kid=\"8\"></span>\n        <span class=\"glass\" data-kid=\"9\"></span>\n      </div>\n\n      <div class=\"wordmark\" data-kid=\"10\"><span data-kid=\"11\">YLDR</span></div>\n    </div>\n\n    \n    <div class=\"col\" data-kid=\"12\">\n      <section class=\"cta-card\" data-kid=\"13\">\n        <h1 data-kid=\"14\">Turn your data into income.</h1>\n        <p data-kid=\"15\">Join the community of Earners taking back control of their data and getting paid for what they share.</p>\n\n        <div class=\"cta-row\" data-kid=\"16\">\n          <div class=\"cta-icon\" aria-hidden=\"true\" data-kid=\"17\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" data-kid=\"18\">\n              <circle cx=\"12\" cy=\"8\" r=\"4\" data-kid=\"19\"></circle>\n              <path d=\"M4 21c0-4 3.6-6 8-6s8 2 8 6\" data-kid=\"20\"></path>\n            </svg>\n          </div>\n          <button class=\"cta-btn\" type=\"button\" data-kid=\"21\">Open Yield Studio</button>\n        </div>\n      </section>\n\n      <section class=\"links\" data-kid=\"22\">\n        <div data-kid=\"23\">\n          <h4 data-kid=\"24\">Get started</h4>\n          <a href=\"#\" data-kid=\"25\">Yield Studio App</a>\n          <a href=\"#\" data-kid=\"26\">Talk to us</a>\n        </div>\n        <div data-kid=\"27\">\n          <h4 data-kid=\"28\">Discover</h4>\n          <a href=\"#\" data-kid=\"29\">Read the Docs</a>\n          <a href=\"#\" data-kid=\"30\">The Journal</a>\n        </div>\n        <div class=\"legal\" data-kid=\"31\">\n          <a href=\"#\" data-kid=\"32\">Privacy Policy</a>\n          <a href=\"#\" data-kid=\"33\">Terms of Service</a>\n          <div class=\"copy\" data-kid=\"34\">© Yieldr 2025</div>\n        </div>\n      </section>\n\n      <nav class=\"socials\" data-kid=\"35\">\n        <a class=\"pill\" href=\"#\" data-kid=\"36\">Discord</a>\n        <a class=\"pill\" href=\"#\" data-kid=\"37\">X</a>\n        <a class=\"pill\" href=\"#\" data-kid=\"38\">Telegram</a>\n      </nav>\n\n      <div class=\"toggle-wrap\" data-kid=\"39\">\n        <span class=\"toggle\" data-kid=\"40\">\n          Off\n          <span class=\"knob\" aria-hidden=\"true\" data-kid=\"41\">\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#101014\" stroke-width=\"2.4\" stroke-linecap=\"round\" data-kid=\"42\">\n              <path d=\"M5 5l14 14M19 5L5 19\" data-kid=\"43\"></path>\n            </svg>\n          </span>\n        </span>\n      </div>\n    </div>\n\n  </div>\n</div>\n",
