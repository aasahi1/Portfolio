      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Kestrel — pick the agent that works your way</title>"
