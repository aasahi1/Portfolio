    "b875b43b-cca0-4f60-9642-d47019f07f49": {
      "type": "variant",
      "id": "b875b43b-cca0-4f60-9642-d47019f07f49",
      "label": "carousel_web_4",
      "parentId": null,
      "rect": {
        "x": 4617,
        "y": 135,
        "w": 1440,
        "h": 1000
      },
      "generation": {
        "prompt": "",
