      "type": "variant",
      "id": "inspiration_node_b118faf00a94",
      "label": "Sitewide",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19020/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/amna.canvas\", nodeId: \"inspiration_node_b118faf00a94\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    --bg:#f7f6f2;\n    --ink:#181410;\n    --muted:#71695c;\n    --muted-2:#8f8676;\n    --wordmark:#c4bcae;   /* soft warm taupe — the giant brand type */\n    --accent:#b0562b;     /* copper primary */\n    --accent-ink:#fff;\n    /* silhouette fills */\n    --horse-a:#241d2b;    /* deep plum-charcoal */\n    --horse-b:#3a3142;\n    --cat-a:#5c3a26;      /* warm sienna */\n    --cat-b:#7a4e33;\n    --bird-a:#2f2a22;\n    --bird-b:#b0562b;\n  }\n  *{box-sizing:border-box}\n  html,body{margin:0}\n  body{\n    background:var(--bg);\n    color:var(--ink);\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    -webkit-font-smoothing:antialiased;\n    overflow-x:hidden;\n  }\n  .stage{\n    position:relative;\n    width:100%;\n    min-height:100vh;\n    max-width:1920px;\n    margin:0 auto;\n    padding:clamp(28px,3.4vw,64px) clamp(24px,3.5vw,72px) 0;\n    display:flex;\n    flex-direction:column;\n    overflow:hidden;\n  }\n\n  /* ---- top row: tagline + nav ---- */\n  .top{\n    position:relative;\n    z-index:4;\n    display:flex;\n    justify-content:space-between;\n    align-items:flex-start;\n    gap:32px;\n  }\n  .tagline{\n    font-size:clamp(20px,2.05vw,30px);\n    line-height:1.14;\n    font-weight:600;\n    letter-spacing:-.01em;\n    max-width:16em;\n    margin:0;\n  }\n  nav.cols{\n    display:flex;\n    gap:clamp(28px,3.8vw,72px);\n    flex-shrink:0;\n  }\n  .col{\n    display:flex;\n    flex-direction:column;\n    gap:.55em;\n    font-size:clamp(15px,1.05vw,20px);\n    line-height:1.15;\n  }\n  .col .head{font-weight:600;color:var(--ink)}\n  .col a{\n    color:var(--muted);\n    text-decoration:none;\n    transition:color .18s ease;\n  }\n  .col a:hover{color:var(--accent)}\n\n  /* ---- illustration cluster ---- */\n  .art{\n    position:absolute;\n    z-index:2;\n    left:0; right:0;\n    top:clamp(90px,9vw,150px);\n    bottom:clamp(240px,20.5vw,340px);\n    pointer-events:none;\n  }\n  .art svg{display:block}\n  .horse{\n    position:absolute;\n    left:2%;\n    bottom:0;\n    width:min(46%,860px);\n    height:auto;\n  }\n  .cat{\n    position:absolute;\n    left:20%;\n    bottom:0;\n    width:min(22%,420px);\n    height:auto;\n  }\n  .bird{\n    position:absolute;\n    left:40%;\n    bottom:0;\n    width:min(9%,170px);\n    height:auto;\n  }\n\n  /* ---- giant wordmark ---- */\n  .wordmark{\n    position:absolute;\n    z-index:1;\n    left:0; right:0;\n    bottom:clamp(-8px,-.4vw,0px);\n    text-align:center;\n    font-family:Georgia,\"Times New Roman\",Cambria,serif;\n    font-weight:400;\n    color:var(--wordmark);\n    font-size:27.2vw;\n    line-height:.82;\n    letter-spacing:-.02em;\n    white-space:nowrap;\n    user-select:none;\n  }\n\n  @media (max-width:720px){\n    .top{flex-direction:column;gap:26px}\n    nav.cols{gap:44px}\n    .art{bottom:24vw}\n    .horse{width:64%;left:-2%}\n    .cat{width:32%;left:16%}\n    .bird{width:13%;left:44%}\n    .wordmark{font-size:30vw}\n  }\n\n  @media (prefers-color-scheme:dark){\n    :root{\n      --bg:#131110;\n      --ink:#f2efe9;\n      --muted:#a49c8f;\n      --wordmark:#443d33;\n      --horse-a:#332b47;\n      --horse-b:#4c4164;\n    }\n  }\n  :root[data-theme=\"dark\"]{\n    --bg:#131110;--ink:#f2efe9;--muted:#a49c8f;--wordmark:#443d33;\n    --horse-a:#332b47;--horse-b:#4c4164;\n  }\n  :root[data-theme=\"light\"]{\n    --bg:#f7f6f2;--ink:#181410;--muted:#71695c;--wordmark:#c4bcae;\n    --horse-a:#241d2b;--horse-b:#3a3142;\n  }\n</style>\n\n  <main class=\"stage\">\n    <div class=\"top\">\n      <h1 class=\"tagline\">Treasury tooling for<br>the modern era</h1>\n      <nav class=\"cols\" aria-label=\"Footer\">\n        <div class=\"col\">\n          <span class=\"head\">Legal</span>\n          <a href=\"#\">Terms of service</a>\n          <a href=\"#\">Privacy notice</a>\n        </div>\n        <div class=\"col\">\n          <span class=\"head\">Contact</span>\n          <a href=\"#\">Telegram</a>\n        </div>\n      </nav>\n    </div>\n\n    <div class=\"art\" aria-hidden=\"true\">\n      <!-- horse silhouette -->\n      <svg class=\"horse\" viewBox=\"0 0 640 560\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"gh\" x1=\"0\" y1=\"0\" x2=\"0.7\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"var(--horse-b)\"></stop>\n            <stop offset=\"1\" stop-color=\"var(--horse-a)\"></stop>\n          </linearGradient>\n        </defs>\n        <path fill=\"url(#gh)\" d=\"\n          M470 60\n          c8-14 20-24 30-20 6 3 4 14 0 24\n          c14 6 26 18 34 34\n          c10 20 12 44 8 66\n          c-4 22-16 40-32 52\n          c-6 10-14 18-24 22\n          c4 26 2 54-6 82\n          c-6 22-16 44-30 62\n          c8 30 10 62 6 92\n          l-30 0\n          c2-28-2-56-12-80\n          c-16 8-34 12-52 12\n          c-2 24-2 50 4 74\n          l-30 0\n          c-4-24-4-50-2-74\n          c-26-2-52-10-74-24\n          c-2 30 0 62 8 92\n          l-30 0\n          c-10-34-12-70-6-104\n          c-20-18-34-42-40-70\n          c-18-4-34-16-42-34\n          c-6-14-6-30 0-42\n          c-16-6-28-20-30-38\n          c-2-16 6-32 20-40\n          c-4-16 0-34 12-46\n          c14-14 36-18 54-10\n          c24-14 52-20 80-20\n          l150 0\n          c22 0 42-14 50-34\n          c4-10 6-22 4-34\n          c8-6 14-16 14-28\n          c0-8-4-16-10-22z\n          M486 96\n          c8 6 16 6 22-2\n          c-4-8-14-12-22-10z\"></path>\n        <path fill=\"var(--horse-a)\" opacity=\".55\" d=\"\n          M300 190\n          c40-6 82-4 120 8\n          c-6 40-24 78-52 106\n          c-30 30-70 48-112 50\n          c8-56 20-116 44-164z\"></path>\n      </svg>\n\n      <!-- sphynx cat silhouette -->\n      <svg class=\"cat\" viewBox=\"0 0 300 380\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"gc\" x1=\"0\" y1=\"0\" x2=\"0.6\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"var(--cat-b)\"></stop>\n            <stop offset=\"1\" stop-color=\"var(--cat-a)\"></stop>\n          </linearGradient>\n        </defs>\n        <path fill=\"url(#gc)\" d=\"\n          M150 22\n          c6-16 16-20 24-14 6 5 6 16 2 28\n          c18 6 34 18 46 34\n          c12 16 20 36 20 58\n          c0 20-8 38-20 52\n          c8 40 6 82-6 120\n          c-8 26-22 50-40 68\n          l-34 0\n          c14-18 26-40 32-64\n          c-16 8-34 12-52 12\n          c-8 20-20 38-34 52\n          l-34 0\n          c16-16 30-36 38-58\n          c-20-10-36-28-44-50\n          c-14-6-24-20-26-36\n          c-2-18 6-36 20-46\n          c-6-16-6-34 2-48\n          c8-16 24-28 42-32\n          c-6-14-6-30 2-42\n          c8-12 22-20 36-20\n          c8-8 18-14 26-16z\n          M132 60\n          c8 8 20 8 28 0\n          c-6-10-22-10-28 0z\"></path>\n      </svg>\n\n      <!-- hoopoe-style bird silhouette -->\n      <svg class=\"bird\" viewBox=\"0 0 200 300\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"gb\" x1=\"0\" y1=\"0\" x2=\"0.6\" y2=\"1\">\n            <stop offset=\"0\" stop-color=\"var(--bird-b)\"></stop>\n            <stop offset=\"1\" stop-color=\"var(--bird-a)\"></stop>\n          </linearGradient>\n        </defs>\n        <!-- crest -->\n        <path fill=\"url(#gb)\" d=\"M96 6c4 18 4 36 0 54c-6-10-14-18-24-22c8-14 16-24 24-32z\"></path>\n        <path fill=\"url(#gb)\" d=\"M112 8c-2 18-2 36 2 52c8-8 14-20 16-34c-4-8-10-14-18-18z\"></path>\n        <!-- beak -->\n        <path fill=\"var(--bird-a)\" d=\"M84 92 L14 118 l0 8 l70-18z\"></path>\n        <!-- head + body -->\n        <path fill=\"url(#gb)\" d=\"\n          M100 56\n          c22 0 40 16 44 38\n          c2 14-2 28-10 38\n          c14 10 22 28 22 48\n          c0 14-4 28-12 40\n          c6 18 6 38-2 56\n          l-26 0\n          c4-14 4-30-2-44\n          c-10 8-24 12-38 12\n          c-2 12-8 24-16 34\n          l-24 0\n          c10-12 18-26 20-42\n          c-14-10-24-26-26-44\n          c-4-24 6-48 26-62\n          c-10-10-16-24-16-40\n          c0-22 18-38 40-42z\"></path>\n        <!-- wing bars -->\n        <path fill=\"var(--bird-a)\" opacity=\".8\" d=\"M70 176 l64 0 l0 8 l-64 0z M78 194 l58 0 l0 8 l-58 0z M84 212 l50 0 l0 8 l-50 0z\"></path>\n      </svg>\n    </div>\n\n    <div class=\"wordmark\">Ironroot</div>\n  </main>\n\n\n",
