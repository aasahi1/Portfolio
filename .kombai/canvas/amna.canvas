      "html": "<style>\n  :root{\n    --teal-900:#053f47;\n    --teal-800:#07636d;\n    --teal-700:#0c8a91;\n    --teal-500:#17aeae;\n    --teal-300:#4fd3c4;\n    --teal-100:#a8ecdf;\n\n    --ink:#0f1b1c;\n    --ink-soft:#3f5150;\n    --ink-mute:#6d807e;\n\n    --clay-600:#a9512f;\n    --clay-500:#c4653e;\n    --clay-100:#f7e2d6;\n\n    --surface:#ffffff;\n    --surface-glass:rgba(246,248,247,.66);\n    --hairline:rgba(255,255,255,.55);\n\n    --r-sm:10px;\n    --r-md:18px;\n    --r-lg:26px;\n    --r-pill:999px;\n\n    --s-1:4px; --s-2:8px; --s-3:12px; --s-4:16px; --s-5:24px;\n    --s-6:32px; --s-7:48px; --s-8:64px;\n\n    --shadow-card:0 44px 84px -36px rgba(3,38,42,.55), 0 12px 28px -14px rgba(3,38,42,.26), 0 1px 0 rgba(255,255,255,.9) inset;\n    --shadow-soft:0 14px 34px -18px rgba(4,44,48,.40);\n    --ease:cubic-bezier(0.16,1,0.3,1);\n  }\n\n  *,*::before,*::after{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Inter,\"Helvetica Neue\",Arial,sans-serif;\n    color:var(--ink);\n    background:var(--teal-800);\n    -webkit-font-smoothing:antialiased;\n    text-rendering:optimizeLegibility;\n    overflow-x:hidden;\n  }\n  img{max-width:100%;display:block;}\n  button{font:inherit;color:inherit;border:0;background:none;cursor:pointer;}\n\n  /* ---------- stage / background ---------- */\n  .hero{\n    position:relative;\n    min-height:100vh;\n    padding:var(--s-5) var(--s-5) var(--s-8);\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    overflow:hidden;\n    isolation:isolate;\n    background:\n      radial-gradient(120% 90% at 12% 8%, #1ea9c9 0%, rgba(30,169,201,0) 55%),\n      radial-gradient(100% 80% at 88% 6%, #0f7fa8 0%, rgba(15,127,168,0) 60%),\n      radial-gradient(140% 120% at 50% 118%, #56e0cd 0%, rgba(86,224,205,0) 58%),\n      linear-gradient(168deg, #0b7fa6 0%, #0e9ab4 38%, #1cc0bd 72%, #3fdcc9 100%);\n  }\n  .hero::before,\n  .hero::after{\n    content:\"\";\n    position:absolute;\n    z-index:-1;\n    border-radius:50%;\n    filter:blur(70px);\n    pointer-events:none;\n  }\n  .hero::before{\n    width:66vw;height:60vw;\n    left:-18vw;bottom:-26vw;\n    background:radial-gradient(circle at 40% 40%, rgba(140,244,224,.85), rgba(140,244,224,0) 70%);\n  }\n  .hero::after{\n    width:52vw;height:46vw;\n    right:-14vw;top:-16vw;\n    background:radial-gradient(circle at 50% 50%, rgba(20,86,150,.55), rgba(20,86,150,0) 70%);\n  }\n  .sheen{\n    position:absolute;inset:0;z-index:-1;pointer-events:none;\n    background:\n      radial-gradient(58% 44% at 22% 62%, rgba(255,255,255,.20), rgba(255,255,255,0) 62%),\n      radial-gradient(40% 30% at 74% 82%, rgba(255,255,255,.14), rgba(255,255,255,0) 66%);\n  }\n\n  /* ---------- top chrome ---------- */\n  .topbar{\n    position:absolute;\n    top:var(--s-5);\n    left:var(--s-5);\n    right:var(--s-5);\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:var(--s-4);\n    z-index:6;\n  }\n  .tabgroup{\n    display:flex;align-items:center;gap:var(--s-2);\n    padding:5px;\n    border-radius:14px;\n    background:rgba(255,255,255,.26);\n    border:1px solid rgba(255,255,255,.34);\n    backdrop-filter:blur(14px) saturate(140%);\n    -webkit-backdrop-filter:blur(14px) saturate(140%);\n    box-shadow:var(--shadow-soft), inset 0 1px 0 rgba(255,255,255,.45);\n  }\n  .tab{\n    display:inline-flex;align-items:center;gap:8px;\n    height:34px;padding:0 12px;border-radius:10px;\n    font-size:14.5px;font-weight:600;letter-spacing:-.01em;\n    color:rgba(255,255,255,.9);\n    transition:background .35s var(--ease), color .35s var(--ease), transform .35s var(--ease);\n  }\n  .tab svg{width:17px;height:17px;flex:none;}\n  .tab:hover{background:rgba(255,255,255,.22);}\n  .tab.is-active{\n    background:var(--surface);\n    color:var(--ink);\n    box-shadow:0 2px 8px -2px rgba(4,44,48,.30);\n  }\n  .tab.is-icon{padding:0 9px;}\n  .avatar-chip{\n    width:38px;height:38px;border-radius:var(--r-pill);\n    display:grid;place-items:center;\n    font-size:14px;font-weight:600;letter-spacing:.01em;\n    color:var(--teal-800);\n    background:var(--surface);\n    border:1px solid rgba(255,255,255,.6);\n    box-shadow:var(--shadow-soft);\n    transition:transform .4s var(--ease);\n  }\n  .avatar-chip:hover{transform:translateY(-1px) scale(1.03);}\n\n  /* ---------- floating app tiles ---------- */\n  .orbit{position:absolute;inset:0;z-index:0;pointer-events:none;}\n  .tile{\n    position:absolute;\n    width:56px;height:56px;\n    border-radius:15px;\n    display:grid;place-items:center;\n    background:rgba(255,255,255,.24);\n    border:1px solid rgba(255,255,255,.38);\n    backdrop-filter:blur(12px) saturate(130%);\n    -webkit-backdrop-filter:blur(12px) saturate(130%);\n    box-shadow:0 18px 34px -20px rgba(3,40,44,.5), inset 0 1px 0 rgba(255,255,255,.5);\n    opacity:.92;\n  }\n  .tile svg{width:28px;height:28px;}\n  .tile.sm{width:46px;height:46px;border-radius:13px;}\n  .tile.sm svg{width:23px;height:23px;}\n  .t1{left:6.5%;top:22%;transform:rotate(-9deg);}\n  .t2{left:26%;top:14%;transform:rotate(7deg);}\n  .t3{left:2.2%;top:58%;transform:rotate(11deg);}\n  .t4{left:27%;top:70%;transform:rotate(-6deg);}\n  .t5{left:15%;top:88%;transform:rotate(5deg);}\n  .t6{right:28%;top:15%;transform:rotate(-8deg);}\n  .t7{right:9%;top:21%;transform:rotate(6deg);}\n  .t8{right:2.5%;top:46%;transform:rotate(-12deg);}\n  .t9{right:26%;top:62%;transform:rotate(9deg);}\n  .t10{right:12%;top:66%;transform:rotate(-5deg);}\n  .t11{left:3%;top:34%;transform:rotate(4deg);}\n  .t12{right:38%;bottom:6%;transform:rotate(-7deg);}\n\n  /* ---------- headline ---------- */\n  .headline{\n    position:relative;z-index:3;\n    margin:0 0 clamp(36px,5vw,62px);\n    text-align:center;\n    font-size:clamp(33px,4.7vw,60px);\n    line-height:1.04;\n    font-weight:700;\n    letter-spacing:-.034em;\n    color:#fdfffe;\n    text-shadow:0 3px 26px rgba(4,44,48,.20);\n  }\n\n  /* ---------- carousel ---------- */\n  .stage{\n    position:relative;z-index:3;\n    display:flex;align-items:center;justify-content:center;\n    width:100%;\n  }\n  .card{\n    border-radius:var(--r-lg);\n    flex:none;\n    transition:transform .6s var(--ease), box-shadow .6s var(--ease);\n  }\n  .card.side{\n    width:262px;height:196px;\n    display:flex;flex-direction:column;align-items:center;justify-content:center;\n    gap:var(--s-4);\n    padding:var(--s-5) var(--s-4);\n    background:var(--surface-glass);\n    border:1px solid var(--hairline);\n    backdrop-filter:blur(22px) saturate(105%) brightness(1.04);\n    -webkit-backdrop-filter:blur(22px) saturate(105%) brightness(1.04);\n    box-shadow:0 26px 52px -30px rgba(3,40,44,.55), inset 0 1px 0 rgba(255,255,255,.7);\n  }\n  .card.far{transform:translateY(9px) scale(.965);opacity:.86;z-index:1;}\n  .card.near{z-index:2;}\n  .far.left{margin-right:-54px;}\n  .near.left{margin-right:-62px;}\n  .near.right{margin-left:-62px;}\n  .far.right{margin-left:-54px;}\n  .card.side:hover{transform:translateY(-4px) scale(1);opacity:1;}\n  .card.far:hover{transform:translateY(4px) scale(.985);opacity:1;}\n\n  .ava{\n    width:72px;height:72px;border-radius:19px;\n    overflow:hidden;flex:none;\n    box-shadow:0 8px 18px -10px rgba(3,40,44,.55);\n  }\n  .ava img{width:100%;height:100%;object-fit:cover;}\n  .ava-1{background:linear-gradient(155deg,#e8eef1,#c3d2d8);}\n  .ava-2{background:linear-gradient(155deg,#fbe9b7,#f0cf7c);}\n  .ava-3{background:linear-gradient(155deg,#f6ccd8,#e9a2b8);}\n  .ava-4{background:linear-gradient(155deg,#dcf3bf,#bfe094);}\n  .side .label{\n    margin:0;text-align:center;\n    font-size:15.5px;font-weight:600;letter-spacing:-.012em;\n    color:#26403f;\n  }\n\n  .card.center{\n    position:relative;z-index:3;\n    width:300px;\n    padding:var(--s-6) var(--s-5) 30px;\n    background:var(--surface);\n    display:flex;flex-direction:column;align-items:center;\n    box-shadow:var(--shadow-card);\n  }\n  .ava-lg{\n    position:relative;\n    width:128px;height:128px;border-radius:28px;\n    overflow:visible;\n    margin-bottom:var(--s-5);\n  }\n  .ava-lg .frame{\n    width:100%;height:100%;border-radius:28px;overflow:hidden;\n    background:linear-gradient(155deg,#f7d2b4,#eaa877);\n    box-shadow:0 10px 22px -12px rgba(3,40,44,.5);\n  }\n  .ava-lg .frame img{width:100%;height:100%;object-fit:cover;}\n  .status-dot{\n    position:absolute;right:2px;bottom:6px;\n    width:17px;height:17px;border-radius:50%;\n    background:#2fae62;\n    border:2.5px solid var(--surface);\n    box-shadow:0 2px 6px -1px rgba(3,40,44,.4);\n  }\n  .card.center h2{\n    margin:0 0 10px;\n    font-size:25px;line-height:1.15;font-weight:700;letter-spacing:-.022em;\n    color:var(--clay-500);\n    text-align:center;\n  }\n  .card.center p{\n    margin:0 0 var(--s-5);\n    max-width:30ch;\n    text-align:center;\n    font-size:14.5px;line-height:1.5;\n    color:var(--ink-soft);\n  }\n  .tags{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}\n  .tag{\n    display:inline-flex;align-items:center;\n    height:32px;padding:0 14px;border-radius:var(--r-pill);\n    font-size:13.5px;font-weight:600;letter-spacing:-.005em;\n    color:var(--clay-600);\n    background:var(--clay-100);\n    transition:transform .4s var(--ease), background .4s var(--ease);\n  }\n  .tag:hover{transform:translateY(-1px);background:#f3d6c5;}\n\n  /* ---------- controls ---------- */\n  .controls{\n    position:relative;z-index:3;\n    display:flex;align-items:center;gap:var(--s-4);\n    margin-top:clamp(28px,3.4vw,44px);\n  }\n  .nav-btn{\n    width:34px;height:34px;border-radius:var(--r-pill);\n    display:grid;place-items:center;\n    background:rgba(255,255,255,.55);\n    border:1px solid rgba(255,255,255,.6);\n    backdrop-filter:blur(10px);\n    -webkit-backdrop-filter:blur(10px);\n    color:#164a4c;\n    box-shadow:0 8px 18px -12px rgba(3,40,44,.6);\n    transition:transform .4s var(--ease), background .4s var(--ease);\n  }\n  .nav-btn:hover{background:rgba(255,255,255,.82);transform:translateY(-1px);}\n  .nav-btn:active{transform:translateY(0) scale(.96);}\n  .nav-btn svg{width:15px;height:15px;}\n  .dots{display:flex;align-items:center;gap:9px;}\n  .dot{\n    width:8px;height:8px;border-radius:var(--r-pill);\n    background:rgba(255,255,255,.5);\n    transition:background .4s var(--ease), width .5s var(--ease);\n  }\n  .dot.is-active{width:58px;background:rgba(255,255,255,.95);}\n  .dot:hover{background:rgba(255,255,255,.8);}\n\n  /* ---------- CTA ---------- */\n  .cta{\n    position:relative;z-index:3;\n    margin-top:clamp(40px,5vw,72px);\n    display:inline-flex;align-items:center;gap:12px;\n    height:56px;padding:0 30px;border-radius:var(--r-pill);\n    font-size:16.5px;font-weight:600;letter-spacing:-.014em;\n    color:#f4fbfa;\n    background:#0d1a1b;\n    box-shadow:0 22px 44px -20px rgba(3,26,28,.72), inset 0 1px 0 rgba(255,255,255,.12);\n    transition:transform .45s var(--ease), box-shadow .45s var(--ease), background .45s var(--ease);\n  }\n  .cta svg{width:17px;height:17px;transition:transform .45s var(--ease);}\n  .cta:hover{transform:translateY(-2px);background:#132726;box-shadow:0 28px 52px -20px rgba(3,26,28,.78);}\n  .cta:hover svg{transform:translateX(3px);}\n  .cta:active{transform:translateY(0);}\n  :focus-visible{outline:2px solid rgba(255,255,255,.9);outline-offset:3px;border-radius:var(--r-sm);}\n\n  /* ---------- responsive ---------- */\n  @media (max-width:1180px){\n    .card.side{width:230px;}\n    .t2,.t6{display:none;}\n  }\n  @media (max-width:980px){\n    .card.far{display:none;}\n    .near.left{margin-right:-56px;}\n    .near.right{margin-left:-56px;}\n    .tile{opacity:.85;}\n    .t3,.t9{display:none;}\n  }\n  @media (max-width:700px){\n    .hero{padding-top:96px;}\n    .card.side{display:none;}\n    .orbit .tile{width:42px;height:42px;border-radius:12px;}\n    .orbit .tile svg{width:21px;height:21px;}\n    .t4,.t10,.t11,.t12{display:none;}\n    .card.center{width:min(320px,86vw);}\n    .dot.is-active{width:42px;}\n  }\n</style>\n\n<main class=\"hero\">\n  <div class=\"sheen\" aria-hidden=\"true\"></div>\n\n  <div class=\"orbit\" aria-hidden=\"true\">\n    <div class=\"tile t1\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"4\" fill=\"#2b6fb5\"/><path d=\"M6.5 9.5h11M6.5 13h7\" stroke=\"#dcecff\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></div>\n    <div class=\"tile sm t2\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3.4\" y=\"6.6\" width=\"11\" height=\"11\" rx=\"3.4\" fill=\"#e2688f\"/><rect x=\"9.6\" y=\"3.4\" width=\"11\" height=\"11\" rx=\"3.4\" fill=\"#c8497a\" opacity=\".8\"/></svg></div>\n    <div class=\"tile t3\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2.6l3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 18.4 5.8 21.7 7 14.8l-5-4.9 6.9-1L12 2.6z\" fill=\"#f2b13c\"/></svg></div>\n    <div class=\"tile sm t4\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3.5\" y=\"3.5\" width=\"17\" height=\"17\" rx=\"5\" fill=\"#1f4f7a\"/><path d=\"M8 15.5V9.2l4 3.4 4-3.4v6.3\" stroke=\"#a9d8ff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n    <div class=\"tile t5\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 17.5c4.5 0 4.5-11 8-11s3.5 11 8 11\" stroke=\"#2f9c8b\" stroke-width=\"2.4\" stroke-linecap=\"round\"/><circle cx=\"4\" cy=\"17.5\" r=\"2\" fill=\"#2f9c8b\"/></svg></div>\n    <div class=\"tile sm t6\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3l7.5 4.3v9.4L12 21l-7.5-4.3V7.3L12 3z\" fill=\"#7a5cd6\"/><path d=\"M12 8.2l3.6 2.1v4.2L12 16.6l-3.6-2.1v-4.2L12 8.2z\" fill=\"#ded4ff\"/></svg></div>\n    <div class=\"tile t7\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2.8c.9 4.3 2.2 5.6 6.5 6.5-4.3.9-5.6 2.2-6.5 6.5-.9-4.3-2.2-5.6-6.5-6.5 4.3-.9 5.6-2.2 6.5-6.5z\" fill=\"#e07a4a\"/><circle cx=\"17.4\" cy=\"17.4\" r=\"3\" fill=\"#f2b78f\"/></svg></div>\n    <div class=\"tile t8\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"#3f7fd6\"/><path d=\"M12 3a9 9 0 000 18\" fill=\"#cfe2ff\"/></svg></div>\n    <div class=\"tile sm t9\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3.5\" y=\"5\" width=\"17\" height=\"15\" rx=\"4\" fill=\"#e6efe9\"/><path d=\"M3.5 9.5h17\" stroke=\"#3d8c6d\" stroke-width=\"1.8\"/><rect x=\"7\" y=\"12.5\" width=\"4\" height=\"4\" rx=\"1.2\" fill=\"#3d8c6d\"/></svg></div>\n    <div class=\"tile t10\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.4 3.6L3.9 10.2c-.8.3-.8 1.5.1 1.7l6.2 1.7 1.7 6.2c.2.9 1.4.9 1.7.1l6.8-16.3z\" fill=\"#c94f4f\"/></svg></div>\n    <div class=\"tile sm t11\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M6 4h12v16l-6-4-6 4V4z\" fill=\"#4a67c9\"/></svg></div>\n    <div class=\"tile sm t12\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"8.6\" stroke=\"#2b8a97\" stroke-width=\"2\"/><path d=\"M12 6.6V12l3.6 2.2\" stroke=\"#2b8a97\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></div>\n  </div>\n\n  <header class=\"topbar\">\n    <div class=\"tabgroup\">\n      <button class=\"tab is-icon\" aria-label=\"Workspace overview\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.9\"/><path d=\"M3 9.5h18\" stroke=\"currentColor\" stroke-width=\"1.9\"/></svg>\n      </button>\n      <button class=\"tab is-active\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 6.5A2.5 2.5 0 016.5 4h11A2.5 2.5 0 0120 6.5v7a2.5 2.5 0 01-2.5 2.5H10l-4.4 3.3a.6.6 0 01-1-.48V16h-.1A.5.5 0 014 15.5v-9z\" fill=\"currentColor\"/></svg>\n        Kestrel\n      </button>\n    </div>\n    <button class=\"avatar-chip\" aria-label=\"Account: Rhea Okonjo\">RO</button>\n  </header>\n\n  <h1 class=\"headline\">Kestrel can be your</h1>\n\n  <section class=\"stage\" aria-label=\"Agent presets\">\n    <article class=\"card side far left\">\n      <div class=\"ava ava-1\"><img src=\"https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&amp;w=220\" alt=\"Portrait by Jake Nackos on Unsplash\" width=\"220\" height=\"220\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n      <p class=\"label\">Daily Aide</p>\n    </article>\n\n    <article class=\"card side near left\">\n      <div class=\"ava ava-2\"><img src=\"https://images.pexels.com/photos/20249686/pexels-photo-20249686.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=220\" alt=\"Portrait by Korede Adenola on Pexels\" width=\"220\" height=\"220\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n      <p class=\"label\">Role Scout</p>\n    </article>\n\n    <article class=\"card center\" aria-current=\"true\">\n      <div class=\"ava-lg\">\n        <div class=\"frame\"><img src=\"https://images.pexels.com/photos/37862665/pexels-photo-37862665.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=400\" alt=\"Portrait by Ben Khatry on Pexels\" width=\"400\" height=\"400\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n        <span class=\"status-dot\" aria-hidden=\"true\"></span>\n      </div>\n      <h2>Build Partner</h2>\n      <p>Reads your pull requests, patches failing tests, and ships the fix before standup.</p>\n      <div class=\"tags\">\n        <span class=\"tag\">#ShipRelease</span>\n        <span class=\"tag\">#CodeReview</span>\n      </div>\n    </article>\n\n    <article class=\"card side near right\">\n      <div class=\"ava ava-3\"><img src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=220\" alt=\"Portrait by Thanh Xuan Nguyen Ly on Pexels\" width=\"220\" height=\"220\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n      <p class=\"label\">Studio Hand</p>\n    </article>\n\n    <article class=\"card side far right\">\n      <div class=\"ava ava-4\"><img src=\"https://images.pexels.com/photos/10816007/pexels-photo-10816007.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=220\" alt=\"Portrait by Prince on Pexels\" width=\"220\" height=\"220\" onerror=\"__crawlAsset&&__crawlAsset(this)\"></div>\n      <p class=\"label\">Deal Maker</p>\n    </article>\n  </section>\n\n  <nav class=\"controls\" aria-label=\"Carousel controls\">\n    <button class=\"nav-btn\" aria-label=\"Previous agent\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n    <div class=\"dots\" role=\"tablist\">\n      <span class=\"dot\" role=\"tab\"></span>\n      <span class=\"dot\" role=\"tab\"></span>\n      <span class=\"dot is-active\" role=\"tab\" aria-selected=\"true\"></span>\n      <span class=\"dot\" role=\"tab\"></span>\n      <span class=\"dot\" role=\"tab\"></span>\n    </div>\n    <button class=\"nav-btn\" aria-label=\"Next agent\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </nav>\n\n  <button class=\"cta\">\n    Create your first Kestrel\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n</main>\n",
