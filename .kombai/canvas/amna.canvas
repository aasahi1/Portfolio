    "inspiration_node_56cb5b20d398": {
      "type": "variant",
      "id": "inspiration_node_56cb5b20d398",
      "label": "Footprint",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19020/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/amna.canvas\", nodeId: \"inspiration_node_56cb5b20d398\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    --bg-top:#211f1c;\n    --bg-bottom:#121110;\n    --surface:#2a2724;\n    --ink:#f6f4ef;\n    --ink-dim:#aaa69e;\n    --ink-faint:#8b877e;\n    --accent:#f0a13c;          /* mango — brand-true warm accent */\n    --accent-2:#ffc266;\n    --accent-ink:#2a1c08;\n    --btn-dark:#171410;\n    --btn-light:#f8f6f0;\n    --radius-card:26px;\n    --radius-btn:14px;\n    --maxw:1600px;\n    --ease-out:cubic-bezier(0.16,1,0.3,1);\n    font-family:-apple-system,\"SF Pro Text\",BlinkMacSystemFont,\"Segoe UI\",system-ui,sans-serif;\n  }\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:linear-gradient(180deg,var(--bg-top) 0%,var(--bg-bottom) 100%);\n    color:var(--ink);\n    min-height:100vh;\n    -webkit-font-smoothing:antialiased;\n  }\n  .footer{\n    max-width:var(--maxw);\n    margin:0 auto;\n    padding:70px 60px 60px;\n  }\n\n  /* Top row: wordmark + promo card */\n  .top{\n    display:flex;\n    gap:48px;\n    align-items:flex-start;\n    justify-content:space-between;\n    flex-wrap:wrap;\n  }\n  .brand{\n    font-weight:800;\n    font-size:56px;\n    letter-spacing:-.03em;\n    line-height:1;\n    margin:6px 0 0;\n  }\n\n  .promo{\n    background:linear-gradient(160deg,var(--accent-2) 0%,var(--accent) 100%);\n    color:var(--accent-ink);\n    border-radius:var(--radius-card);\n    padding:44px 44px 40px;\n    width:640px;\n    max-width:100%;\n    flex-shrink:0;\n    box-shadow:0 30px 60px -30px rgba(240,161,60,0.35);\n  }\n  .promo h2{\n    font-size:44px;\n    line-height:1.05;\n    letter-spacing:-.02em;\n    font-weight:700;\n    margin:0 0 30px;\n    max-width:11ch;\n  }\n  .promo ul{list-style:none;margin:0 0 40px;padding:0;display:flex;flex-direction:column;gap:18px;}\n  .promo li{display:flex;align-items:center;gap:16px;font-size:18px;font-weight:500;}\n  .check{\n    width:34px;height:34px;flex-shrink:0;border-radius:50%;\n    background:var(--btn-dark);display:flex;align-items:center;justify-content:center;\n  }\n  .check svg{width:17px;height:17px;stroke:#fff;}\n  .promo-actions{display:flex;gap:14px;flex-wrap:wrap;}\n  .btn{\n    border:0;cursor:pointer;font-size:17px;font-weight:600;font-family:inherit;\n    border-radius:var(--radius-btn);padding:16px 28px;display:inline-flex;\n    align-items:center;gap:12px;text-decoration:none;\n    transition:transform .25s var(--ease-out), opacity .25s var(--ease-out);\n  }\n  .btn:hover{transform:translateY(-2px);}\n  .btn:active{transform:translateY(1px) scale(0.98);}\n  .btn:focus-visible{outline:2px solid var(--btn-dark);outline-offset:2px;}\n  .btn-dark{background:var(--btn-dark);color:#fff;}\n  .btn-dark svg{width:18px;height:18px;stroke:#fff;}\n  .btn-light{background:var(--btn-light);color:#1b1a17;}\n\n  /* Nav columns — sit under the brand, filling the left half */\n  .nav{\n    display:flex;\n    gap:90px;\n    margin-top:64px;\n    flex-wrap:wrap;\n  }\n  .top-left .nav{ margin-top:72px; }\n  .nav h3{\n    font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;\n    margin:0 0 26px;color:var(--ink-faint);\n  }\n  .nav ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px;}\n  .nav a{\n    color:var(--ink-dim);text-decoration:none;font-size:17px;\n    display:inline-flex;align-items:center;gap:12px;\n    transition:color .2s var(--ease-out);\n  }\n  .nav a:hover{color:var(--ink);}\n  .tag{\n    display:inline-flex;align-items:center;gap:8px;color:var(--accent);font-size:14px;font-weight:600;\n  }\n  .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);display:inline-block;}\n\n  /* Social */\n  .social{display:flex;gap:26px;margin:70px 0 0;}\n  .social a{color:var(--ink-faint);display:inline-flex;transition:color .2s var(--ease-out),transform .2s var(--ease-out);}\n  .social a:hover{color:var(--ink);transform:translateY(-2px);}\n  .social svg{width:22px;height:22px;fill:currentColor;}\n\n  /* Bottom bar */\n  .bottom{\n    display:flex;justify-content:space-between;align-items:flex-start;\n    gap:40px;margin-top:34px;flex-wrap:wrap;\n  }\n  .blurb{color:var(--ink-faint);font-size:16px;line-height:1.6;max-width:58ch;margin:0;}\n  .legal{text-align:right;color:var(--ink-faint);font-size:15px;}\n  .legal .copy{margin:0 0 12px;}\n  .legal-links{display:flex;gap:36px;justify-content:flex-end;}\n  .legal-links a{color:var(--ink-dim);text-decoration:none;transition:color .2s var(--ease-out);}\n  .legal-links a:hover{color:var(--ink);}\n\n  @media(max-width:900px){\n    .footer{padding:48px 26px 40px;}\n    .brand{font-size:42px;}\n    .promo{padding:32px 28px;}\n    .promo h2{font-size:34px;}\n    .promo li{font-size:18px;}\n    .nav{gap:60px;margin-top:48px;}\n    .bottom{flex-direction:column;}\n    .legal,.legal-links{text-align:left;justify-content:flex-start;}\n  }\n</style>\n\n  <footer class=\"footer\">\n    <div class=\"top\">\n      <div class=\"top-left\">\n        <p class=\"brand\">mangolane</p>\n\n        <nav class=\"nav\">\n          <div>\n            <h3>Resources</h3>\n            <ul>\n              <li><a href=\"#\">Blog</a></li>\n              <li><a href=\"#\">Webinars</a></li>\n              <li><a href=\"#\">Playbooks <span class=\"tag\"><span class=\"dot\"></span>New</span></a></li>\n              <li><a href=\"#\">Support</a></li>\n            </ul>\n          </div>\n          <div>\n            <h3>Company</h3>\n            <ul>\n              <li><a href=\"#\">Platform</a></li>\n              <li><a href=\"#\">Story</a></li>\n              <li><a href=\"#\">Careers <span class=\"tag\"><span class=\"dot\"></span>Hiring</span></a></li>\n              <li><a href=\"#\">Customer Stories</a></li>\n            </ul>\n          </div>\n        </nav>\n      </div>\n\n      <div class=\"promo\">\n        <h2>Turn Collabs Into Effortless Wins</h2>\n        <ul>\n          <li>\n            <span class=\"check\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span>\n            Get sharper returns on every budget\n          </li>\n          <li>\n            <span class=\"check\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span>\n            Cut 80% of the busywork per launch\n          </li>\n        </ul>\n        <div class=\"promo-actions\">\n          <a class=\"btn btn-dark\" href=\"#\">Start free <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"></path><path d=\"m13 5 7 7-7 7\"></path></svg></a>\n          <a class=\"btn btn-light\" href=\"#\">Book a demo</a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"social\">\n      <a href=\"#\" aria-label=\"Twitter\"><svg viewBox=\"0 0 24 24\"><path d=\"M22 5.9c-.7.3-1.5.5-2.3.6.8-.5 1.5-1.3 1.8-2.3-.8.5-1.6.8-2.5 1a3.9 3.9 0 0 0-6.7 3.6A11 11 0 0 1 4.1 5a3.9 3.9 0 0 0 1.2 5.2c-.6 0-1.2-.2-1.7-.5v.1c0 1.9 1.3 3.5 3.1 3.8-.6.2-1.2.2-1.8.1a3.9 3.9 0 0 0 3.6 2.7A7.8 7.8 0 0 1 2 18.3a11 11 0 0 0 6 1.7c7.2 0 11.1-6 11.1-11.1v-.5c.8-.6 1.4-1.3 2-2.1z\"></path></svg></a>\n      <a href=\"#\" aria-label=\"Instagram\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.2-.1 1.6-.1 4.8-.1zm0 3.2A6.6 6.6 0 1 0 12 18.6 6.6 6.6 0 0 0 12 5.4zm0 10.9a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm6.9-11.1a1.5 1.5 0 1 1-3.1 0 1.5 1.5 0 0 1 3.1 0z\"></path></svg></a>\n      <a href=\"#\" aria-label=\"LinkedIn\"><svg viewBox=\"0 0 24 24\"><path d=\"M6.9 8.2H3.5V21h3.4V8.2zM5.2 3.2A2 2 0 1 0 5.2 7.2a2 2 0 0 0 0-4zM20.5 21h-3.4v-6.2c0-1.5 0-3.4-2.1-3.4s-2.4 1.6-2.4 3.3V21H9.2V8.2h3.3v1.7h.1c.5-.9 1.6-1.9 3.3-1.9 3.5 0 4.6 2.3 4.6 5.3V21z\"></path></svg></a>\n      <a href=\"#\" aria-label=\"YouTube\"><svg viewBox=\"0 0 24 24\"><path d=\"M23 7.5a3 3 0 0 0-2.1-2.1C19 4.9 12 4.9 12 4.9s-7 0-8.9.5A3 3 0 0 0 1 7.5 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.5a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.5 31 31 0 0 0-.5-4.5zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z\"></path></svg></a>\n    </div>\n\n    <div class=\"bottom\">\n      <p class=\"blurb\">Mangolane helps modern teams grow through creator partnerships — sourcing, briefing, and managing every collaboration from a single connected workspace.</p>\n      <div class=\"legal\">\n        <p class=\"copy\">© 2026 Mangolane Labs Inc. All rights reserved.</p>\n        <div class=\"legal-links\">\n          <a href=\"#\">Terms</a>\n          <a href=\"#\">Privacy policy</a>\n        </div>\n      </div>\n    </div>\n  </footer>\n\n\n",
