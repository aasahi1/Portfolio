    "inspiration_node_9c785fc7c80a": {
      "type": "variant",
      "id": "inspiration_node_9c785fc7c80a",
      "label": "Foundry",
      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19020/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/amna.canvas\", nodeId: \"inspiration_node_9c785fc7c80a\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    --bg-dark:#0a1512;\n    --panel:#ffffff;\n    --ink:#0d1a16;\n    --muted:#0d1a16;\n    --accent:#12b981;      /* emerald primary */\n    --accent-2:#0891a5;    /* teal */\n    --hire:var(--wm-2);\n    /* wordmark gradient stops (teal → emerald → cyan on dark) */\n    --wm-1:#06251f;\n    --wm-2:#0f6b52;\n    --wm-3:#14c08a;\n    --wm-4:#0aa7b8;\n    --radius:34px;\n    --link-size:22px;\n    --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n  *{box-sizing:border-box;margin:0;padding:0;}\n  html,body{background:var(--bg-dark);font-family:var(--font);-webkit-font-smoothing:antialiased;}\n\n  .wrap{\n    max-width:1920px;\n    margin:0 auto;\n    background:\n      radial-gradient(120% 90% at 30% 0%, rgba(20,192,138,.55), transparent 55%),\n      radial-gradient(120% 90% at 78% 0%, rgba(10,167,184,.45), transparent 55%),\n      linear-gradient(180deg,#123a30 0%, #0a1512 60%);\n    padding-top:44px;\n  }\n\n  /* white rounded panel */\n  .panel{\n    background:var(--panel);\n    border-radius:var(--radius) var(--radius) 0 0;\n    padding:0 clamp(24px,3.3vw,64px);\n    overflow:hidden;\n  }\n\n  /* giant wordmark */\n  .wordmark{\n    font-weight:800;\n    letter-spacing:-.03em;\n    line-height:.9;\n    font-size:clamp(84px,15.6vw,300px);\n    margin:clamp(40px,5vw,90px) 0 clamp(48px,4.4vw,80px);\n    padding-bottom:.14em;\n    margin-bottom:calc(clamp(48px,4.4vw,80px) - .14em);\n    background:linear-gradient(96deg,var(--wm-1) 6%, var(--wm-2) 34%, var(--wm-3) 64%, var(--wm-4) 100%);\n    -webkit-background-clip:text;\n    background-clip:text;\n    color:transparent;\n    -webkit-text-fill-color:transparent;\n    user-select:none;\n  }\n\n  /* link columns */\n  .cols{\n    display:grid;\n    grid-template-columns:repeat(5,1fr);\n    gap:34px 24px;\n    padding-bottom:clamp(60px,6vw,110px);\n  }\n  .col ul{list-style:none;}\n  .col li{margin-bottom:20px;}\n  .flink{\n    display:inline-flex;\n    align-items:center;\n    gap:12px;\n    color:var(--ink);\n    text-decoration:none;\n    font-size:var(--link-size);\n    font-weight:500;\n  }\n  .flink svg{flex:none;color:var(--accent);}\n  .flink:hover{color:var(--accent-2);}\n  .flink:hover svg{color:var(--accent-2);}\n  .hiring{\n    color:var(--hire);\n    font-size:13px;\n    font-weight:600;\n    margin-left:6px;\n    white-space:nowrap;\n  }\n\n  .legal{\n    padding:0 0 clamp(48px,5vw,88px);\n    color:var(--ink);\n    font-size:14px;\n    letter-spacing:.06em;\n    font-weight:600;\n    line-height:1.5;\n  }\n\n  @media (max-width:1100px){\n    .cols{grid-template-columns:repeat(2,1fr);}\n  }\n  @media (max-width:560px){\n    .cols{grid-template-columns:1fr;}\n    :root{--link-size:18px;}\n  }\n</style>\n<footer class=\"wrap\">\n  <div class=\"panel\">\n    <div class=\"wordmark\">wellspring</div>\n\n    <nav class=\"cols\">\n      <div class=\"col\">\n        <ul>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>How it Works</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>What's Included</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Gift Wellspring</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col\">\n        <ul>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Member Login</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Our Mission</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Join the Team<span class=\"hiring\">We're hiring!</span></a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Wellspring Labs</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col\">\n        <ul>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>For Creators</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>For Partners</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>For Teams</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col\">\n        <ul>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>X / Twitter</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Instagram</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>LinkedIn</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col\">\n        <ul>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Terms</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Privacy Policy</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>FAQ</a></li>\n          <li><a class=\"flink\" href=\"#\"><svg width=\"14\" height=\"16\" viewBox=\"0 0 14 16\" fill=\"none\"><path d=\"M3 2l7 6-7 6\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>Contact us</a></li>\n        </ul>\n      </div>\n    </nav>\n\n    <div class=\"legal\">\n      2026 WELLSPRING HEALTH, INC<br>\n      ALL RIGHTS RESERVED\n    </div>\n  </div>\n</footer>\n",
